{
  "repositories": [
    {
      "id": "lrd-back",
      "name": "lrd-back",
      "github": "Bryleo2009/lrd-back",
      "cloneUrl": "git@github.com:Bryleo2009/lrd-back.git",
      "shortName": "back",
      "kind": "backend",
      "enabled": true,
      "allowedBases": [
        "release/fase2",
        "release/fase3.1",
        "main"
      ],
      "defaultBase": "release/fase2",
      "checkCommand": "bash scripts/check-backend",
      "qaStages": [
        [
          "composer validate --strict",
          "bash scripts/pint-changed",
          "php artisan optimize:clear"
        ],
        [
          "bash scripts/migrate-ci"
        ],
        [
          "php artisan test"
        ]
      ],
      "qaEnv": {
        "APP_ENV": "testing",
        "APP_KEY": "${APP_KEY_CI:-base64:11Y0OKRkUCxvVnOp0TfX9qp42HbNKeCLqH7QE2iYT7E=}",
        "DB_CONNECTION": "${CI_DB_CONNECTION:-mysql}",
        "DB_HOST": "${CI_DB_HOST:-127.0.0.1}",
        "DB_PORT": "${CI_DB_PORT:-3306}",
        "DB_DATABASE": "${CI_DB_DATABASE:-lrd_ci}",
        "DB_USERNAME": "${CI_DB_USERNAME:-lrd_ci}",
        "DB_PASSWORD": "${CI_DB_PASSWORD:-lrd_ci}",
        "CACHE_STORE": "array",
        "QUEUE_CONNECTION": "sync",
        "SESSION_DRIVER": "array",
        "MAIL_MAILER": "array"
      },
      "qaParallelTests": false
    },
    {
      "id": "lrd-front",
      "name": "lrd-front",
      "github": "Bryleo2009/lrd-front",
      "cloneUrl": "git@github.com:Bryleo2009/lrd-front.git",
      "shortName": "front",
      "kind": "frontend",
      "enabled": true,
      "allowedBases": [
        "release/fase2",
        "release/fase3.1",
        "main"
      ],
      "defaultBase": "release/fase2",
      "checkCommand": "npm run check-frontend",
      "qaStages": [
        [
          "npm run lint:check",
          "npm run type-check",
          "npm run test",
          "npm run build"
        ]
      ]
    },
    {
      "id": "ofsystem",
      "name": "OfSystem",
      "github": "Bryleo2009/OfSystem",
      "cloneUrl": "git@github.com:Bryleo2009/OfSystem.git",
      "shortName": "ofsystem",
      "enabled": false,
      "allowedBases": [
        "main"
      ],
      "defaultBase": "main"
    },
    {
      "id": "erp-ofsystem-back",
      "name": "erp-ofsystem-back",
      "github": "Bryleo2009/erp-ofsystem-back",
      "cloneUrl": "git@github.com:Bryleo2009/erp-ofsystem-back.git",
      "shortName": "erp-back",
      "kind": "backend",
      "enabled": false,
      "allowedBases": [
        "main"
      ],
      "defaultBase": "main"
    },
    {
      "id": "erp-ofsystem-front",
      "name": "erp-ofsystem-front",
      "github": "Bryleo2009/erp-ofsystem-front",
      "cloneUrl": "git@github.com:Bryleo2009/erp-ofsystem-front.git",
      "shortName": "erp-front",
      "kind": "frontend",
      "enabled": false,
      "allowedBases": [
        "main"
      ],
      "defaultBase": "main"
    },
    {
      "id": "lrd-deploy-scripts",
      "name": "lrd-deploy-scripts",
      "github": "Bryleo2009/lrd-deploy-scripts",
      "cloneUrl": "git@github.com:Bryleo2009/lrd-deploy-scripts.git",
      "shortName": "deploy",
      "enabled": false,
      "allowedBases": [
        "main"
      ],
      "defaultBase": "main"
    }
  ],
  "protectedBranches": [
    "main",
    "release/fase2",
    "release/fase3.1"
  ]
}
