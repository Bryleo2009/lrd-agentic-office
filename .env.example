PORT=4173
HOST=127.0.0.1

AI_PROVIDER_MODE=cli
AI_ENGINE_DEFAULT=codex

CODEX_ENABLED=true
CLAUDE_ENABLED=true

CODEX_COMMAND=codex
CLAUDE_COMMAND=claude

ALLOW_PAID_API_FALLBACK=false

GITHUB_PUSH_ENABLED=true
GITHUB_PR_ENABLED=false

LRD_WORKSPACE_ROOT=~/.lrd-agentic-office

# Motor por agente (opcional). Ejemplo: AGENT_ENGINES=diego:claude,rafa:codex
AGENT_ENGINES=

# Revisión final de Atlas con el motor IA (consume cuota de tu suscripción)
ATLAS_REVIEW_ENABLED=true
# Ciclos de corrección si QA falla
QA_FIX_ITERATIONS=1
# Tiempo máximo por paso de agente (minutos)
AGENT_STEP_TIMEOUT_MIN=30
VISUAL_PACING_MS=4000

# Comandos de QA a la vez (build, pruebas...). 1 = en serie
QA_PARALLEL=3

# Veces que una misión se retoma sola tras reinicios del servidor
MISSION_MAX_RESUMES=3

# GitHub Actions tras publicar la rama (requiere gh con sesión)
CI_WAIT_ENABLED=true
CI_FIX_ITERATIONS=2
CI_TIMEOUT_MIN=40
CI_APPEAR_SEC=180

# Codex + Claude: repartir pasos, recordar saturación y revisión cruzada
ENGINE_STRATEGY=mix
ENGINE_COOLDOWN_MIN=30
CROSS_REVIEW=true
CROSS_REVIEW_FIX_ROUNDS=1

# Preguntas al usuario: un agente con una duda que solo tú puedes resolver pausa su paso y te pregunta
QUESTION_TIMEOUT_MIN=120
MAX_QUESTIONS_PER_STEP=2

# Seguridad antes de publicar: revisión de secretos y aprobación (direct = entrega directa en la rama base)
SECRET_SCAN=true
REQUIRE_APPROVAL=direct,migrations
APPROVAL_TIMEOUT_MIN=120

# Mantenimiento: días que se conservan worktrees y logs de misiones terminadas (0 = no limpiar)
RETENTION_DAYS=14
# Borrar el worktree de una misión apenas su trabajo ya está en una rama principal
CLEANUP_MERGED=true

# QA de lrd-back: base MySQL de pruebas (como el CI). Solo si la tuya no es lrd_ci@127.0.0.1:3306
# CI_DB_HOST=127.0.0.1
# CI_DB_PORT=3306
# CI_DB_DATABASE=lrd_ci
# CI_DB_USERNAME=lrd_ci
# CI_DB_PASSWORD=lrd_ci
